# Neon ù usar URL con pooler (-pooler) en desarrollo para evitar "Connection terminated"
# Ej: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Opcional: mùximo de conexiones del pool local (default 5)
# DATABASE_POOL_MAX=5

# Clerk ù copiar exactas desde dashboard.clerk.com
# Dashboard ? User & Authentication ? Email, Password: habilitar "Password" en Sign-in y Sign-up
# Usar comillas SIMPLES si la publishable key termina en $ (dotenv lo trunca sin comillas)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='pk_test_...'
CLERK_SECRET_KEY='sk_test_...'
# Desactiva modo keyless en desarrollo cuando ya tienes keys del dashboard
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
# LOCAL: usa siempre pk_test/sk_test (Development). NO uses pk_live en localhost:
#   - proxy en localhost + pk_live ? host_invalid
#   - FAPI custom (clerk.www.pragmapms.com) tiene TLS roto sin proxy
# PRODUCCI”N / Preview (Vercel): el cÛdigo activa /__clerk solo fuera de localhost.
# Override opcional (path o URL absoluta); en npm run dev no hace falta.
# NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# Webhook ù Dashboard Clerk ? Webhooks ? endpoint /api/webhooks/clerk
CLERK_WEBHOOK_SECRET='whsec_...'

# URL pùblica de producciùn (sin barra final). En local, npm run dev define NEXT_PUBLIC_DEV_ORIGIN automùticamente.
NEXT_PUBLIC_APP_URL=https://www.pragmapms.com
APP_URL=https://www.pragmapms.com
# NEXT_PUBLIC_DEV_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/panel
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Sync en servidor (Authorization: Bearer CRON_SECRET o ?secret= en la URL)
# GET /api/cron/airbnb-ical-sync
# GET /api/cron/billing-renewal
# GET /api/cron/guest-payment-reconcile   ù expira links + reconcilia pagos huùsped (Wompi tenant)
# Limpieza histùrica de links auto-emitidos al crear reserva (default: desactivado)
ENABLE_AUTO_PAYMENT_LINK_CLEANUP=false
# GET /api/cron/pricelabs-sync
# GET /api/cron/ttlock-sync
# CRON_SECRET=

# Airbnb Email Ingestion Layer (no reemplaza iCal)
# Manual/test JSON: POST /api/inbound/airbnb-email
# Header: Authorization: Bearer AIRBNB_EMAIL_WEBHOOK_SECRET
# Body requiere organizationId + from + subject (integraciùn tenant activa)
# AIRBNB_EMAIL_WEBHOOK_SECRET=
# Resend inbound: POST /api/webhooks/resend/inbound  (event email.received, Svix signature)
# RESEND_INBOUND_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...   (tambiùn usado para fetch body de correos recibidos)
# AIRBNB_INBOUND_EMAIL_DOMAIN=inbound.pragmapms.com

# Localhost performance (dev)
# NEXT_DEV_WEBPACK=1
#   ? fuerza webpack si Turbopack se cuelga en Windows. Default: Turbopack.
# NEXT_PUBLIC_AIRBNB_AUTO_SYNC_DEV=true
#   ? auto-sync iCal en background durante npm run dev (default: off).
# AIRBNB_EMAIL_INGEST_DEV=true
#   ? procesa webhooks Resend/Airbnb en local/ngrok (default: off).
# AIRBNB_EMAIL_VERBOSE_LOG=true
#   ? logs info airbnb-email (default: off en development).
# NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# PriceLabs Customer API (Open API)
# Opciùn A: pegar la API key en Integraciones ? PriceLabs (recomendado, se guarda cifrada)
# Opciùn B: variable de entorno (fallback si no hay key en BD)
# PRICELABS_API_KEY=
# PRICELABS_BASE_URL=https://api.pricelabs.co
# PRICELABS_PMS_NAME=other
# PRICELABS_API_ENABLED=false
#   ? solo si quieres modo simulaciùn sin llamadas reales (por defecto: live)
# PRICELABS_TIMEOUT_MS=300000
# Cron: GET /api/cron/pricelabs-sync (Bearer CRON_SECRET)
# Tras desplegar: npm run db:migrate:deploy

# Wompi (Colombia ù tokenized billing, no raw card storage in PRAGMA)
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_ENV=test
#   test | sandbox ? sandbox; production | prod ? live
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1
# WOMPI_WEBHOOK_URL=https://pragma-pms.vercel.app/api/payments/wompi/webhook

# PRAGMA_BANK_ACCOUNT=
# PRAGMA_BANK_HOLDER=PRAGMA SAS
# PRAGMA_BANK_NIT=
# Contacto de facturaciùn (comprobantes / soporte de cobro ù NO es el remitente saliente)
# PRAGMA_BILLING_EMAIL=facturacion@pragmapms.com

# Correos transaccionales salientes (Resend)
# Remitente institucional ùnico:
# EMAIL_FROM="PRAGMA PMS <noreply@pragmapms.com>"
# RESEND_API_KEY=re_...

# ePayco (Payment Links del tenant ù credenciales por organizaciùn en /integrations/epayco)
# URL confirmaciùn en dashboard ePayco: https://<dominio>/api/webhooks/epayco

# TTLock Smart Access ? credenciales de la app PRAGMA (solo servidor)
# TTLOCK_CLIENT_ID=
# TTLOCK_CLIENT_SECRET=
# TTLOCK_ENCRYPTION_KEY=
# TTLOCK_API_ENABLED=true
#   Live API is ON by default when unset. Set TTLOCK_API_ENABLED=false to kill-switch.
#   Codes are never faked locally: generation still requires a real OAuth session in DB.

# Authorize UI (browser login): euopen | Token + API: euapi
# TTLOCK_OAUTH_WEB_URL=https://euopen.ttlock.com
# TTLOCK_API_BASE_URL=https://euapi.ttlock.com
# Callback canùnica ù ùnica fuente para OAuth TTLock (registrar EXACTA en TTLock Open Platform):
TTLOCK_REDIRECT_URI=https://www.pragmapms.com/api/integrations/ttlock/callback
# OAuth navegador (true en producciùn por defecto; false = solo conexiùn por cuenta)
# TTLOCK_BROWSER_OAUTH=true

# Platform Super Admin Owner (global tenant visibility)
# PLATFORM_OWNER_EMAIL=bsionaryup@gmail.com
# NEXT_PUBLIC_PLATFORM_OWNER_EMAIL=bsionaryup@gmail.com
# Owner login: /owner-login (email OTP via Clerk)
# PLATFORM_IMPERSONATION_SECRET=  # optional; falls back to CLERK_SECRET_KEY
# PLATFORM_IMPERSONATION_TTL_MS=7200000

# SIRE (Migraciùn Colombia) ù prueba de conexiùn real desde Integraciones ? SIRE
# Por defecto: portal JSF (documento + contraseùa del portal SIRE).
# Client ID = nùmero de documento | Client Secret = cùdigo tipo doc (ej. 10) | API Key = contraseùa
# Callback URL = ID de empresa (formLogin:listaEmpresa) si aplica
# SIRE_PORTAL_BASE_URL=https://apps.migracioncolombia.gov.co
# SIRE_PORTAL_LOGIN_PATH=/sire/public/login.jsf
# SIRE_REQUEST_TIMEOUT_MS=30000
# SIRE_DEFAULT_DOCUMENT_TYPE=10
# Modo API partner (opcional): define SIRE_API_BASE_URL y credenciales OAuth en el formulario
# SIRE_AUTH_MODE=portal
# SIRE_API_BASE_URL=
# SIRE_API_TOKEN_PATH=/oauth/token
# SIRE_API_TEST_PATH=/health
# SIRE_API_GRANT_TYPE=client_credentials
# SIRE_API_SCOPE=

# TRAA / TRA PMS (MINCIT) ù Integraciones ? TRAA
# Client ID = RNT | Token = token PMS (pms.mincit.gov.co/token) | API Key = alternativa al Token
# TRAA_API_BASE_URL=https://pms.mincit.gov.co
# TRAA_API_PRIMARY_PATH=/one/
# TRAA_REQUEST_TIMEOUT_MS=30000
# Por defecto la prueba solo valida el token (POST {}); no registra huùsped de prueba.
# TRAA_TEST_SEND_PAYLOAD=true
# TRAA_TEST_PAYLOAD_JSON={"tipo_identificacion":"C.C",...}

