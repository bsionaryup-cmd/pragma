{
  "manifest_version": 3,
  "key": "",
  "name": "PRAGMA AI Concierge",
  "version": "1.0.19",
  "description": "PRAGMA AI Concierge channel. v1.0.19: bridge resilience — honest heartbeat, queue/ack, safe reload gates.",
  "permissions": ["storage", "activeTab", "alarms", "tabs"],
  "host_permissions": [
    "https://www.airbnb.com/*",
    "https://www.airbnb.com.co/*",
    "https://web.whatsapp.com/*",
    "https://*.pragmapms.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PRAGMA AI Concierge"
  },
  "externally_connectable": {
    "matches": [
      "https://*.pragmapms.com/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-shared.js", "content-whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.airbnb.com/*",
        "https://www.airbnb.com.co/*"
      ],
      "js": ["content-shared.js", "content-airbnb.js"],
      "run_at": "document_idle"
    }
  ]
}
